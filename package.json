{
  "name": "@xyteai/cli",
  "version": "0.9.0",
  "description": "Xyte CLI, TUI, skills, and headless contracts for zero-friction AI operations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyte-io/xyte-cli.git"
  },
  "bugs": {
    "url": "https://github.com/xyte-io/xyte-cli/issues"
  },
  "homepage": "https://github.com/xyte-io/xyte-cli#readme",
  "keywords": [
    "xyte",
    "cli",
    "tui",
    "agent",
    "operations"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "xyte-cli": "dist/bin/xyte-cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "docs/schemas"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke:pack-install",
    "install:global": "npm run build && npm link",
    "uninstall:global": "node scripts/uninstall_global.mjs",
    "reinstall:global": "npm run uninstall:global && npm run install:global",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:xyte:local": "node scripts/mock_xyte_local.mjs",
    "smoke:local:utilities": "node scripts/smoke_local_utilities.mjs",
    "smoke:local:flow-pack": "tsx tests/smoke/flow-pack-local.ts",
    "smoke:pack-install": "tsx tests/smoke/pack-install.ts",
    "smoke:windows:native-secret-store": "tsx tests/smoke/windows-native-secret-store.ts",
    "smoke:external-live": "tsx tests/smoke/external-user-live.ts",
    "smoke:upgrade:controlled": "node scripts/smoke_upgrade_controlled.mjs",
    "test:commit": "npm run typecheck && npm test && npm run smoke:pack-install",
    "release:check": "node scripts/release_check.mjs",
    "tui": "tsx src/bin/xyte-cli.ts tui",
    "release:publish": "node scripts/publish.mjs all",
    "release:publish:cli": "node scripts/publish.mjs cli",
    "release:publish:pages": "node scripts/publish.mjs pages"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "blessed": "^0.1.81",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "fuse.js": "^7.3.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/blessed": "^0.1.25",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.17.4",
    "ajv": "^8.18.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^2.1.8"
  }
}
