{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xyte.dev/schemas/upgrade-check.v2.schema.json",
  "title": "Xyte Upgrade Check V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "packageName",
    "installChannel",
    "currentVersion",
    "latestVersion",
    "upToDate",
    "recommendedCommand"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xyte.upgrade.check.v2"
    },
    "generatedAtUtc": {
      "type": "string"
    },
    "packageName": {
      "type": "string"
    },
    "installChannel": {
      "enum": [
        "npm",
        "windows-msi"
      ]
    },
    "currentVersion": {
      "type": "string"
    },
    "latestVersion": {
      "type": "string"
    },
    "upToDate": {
      "type": "boolean"
    },
    "recommendedCommand": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
